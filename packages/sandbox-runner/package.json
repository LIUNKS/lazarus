    "@lazarus/pbt-verifier": "workspace:*",
    "fast-check": "^4.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }

{
  "name": "@lazarus/pbt-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./shared": { "types": "./dist/shared.d.ts", "import": "./dist/shared.js", "default": "./dist/shared.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}

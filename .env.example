# --- Supabase (public, browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SERVER ONLY: never import in client components, never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Flyway (loaded by `pnpm db:migrate` via dotenv-cli) ---
# FLYWAY_URL: JDBC URL of the database that receives the migrations. Two forms are supported.
# Form A, Direct connection (port 5432). Note: may be IPv6-only on some Supabase projects.
FLYWAY_URL=jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres?sslmode=require
# FLYWAY_USER: database role Flyway connects as.
FLYWAY_USER=postgres
# Form B, Session Pooler (port 5432, IPv4-friendly). Use instead of Form A if your network lacks IPv6:
# FLYWAY_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# FLYWAY_USER=postgres.your-project-id
# The Transaction Pooler (port 6543) is not supported for FLYWAY_URL: Flyway needs session-level advisory locks.
# FLYWAY_PASSWORD: password of the FLYWAY_USER role. Never commit a real value.
FLYWAY_PASSWORD=your-db-password

# --- Verification suite (db/tests) ---
# TEST_DATABASE_URL: connection string of a DISPOSABLE Postgres database used by `pnpm test`.
# The suite creates and deletes its own rows and creates scratch databases next to it.
# Never point it at a real Supabase project. `pnpm test:db` starts the local Docker database on port 54329.
# When unset, every database test is skipped. Local Docker default:
# TEST_DATABASE_URL=postgresql://postgres:your-local-password@localhost:54329/lazarus_test

# --- LLM provider (Vercel AI SDK + Groq, SERVER ONLY) ---
# GROQ_API_KEY: API key for the Groq provider. Required for Seance and Reincarnation generation.
GROQ_API_KEY=your-groq-api-key
# LLM_MODEL: Groq model id. Defaults to openai/gpt-oss-120b. Never use llama-3.3-70b-versatile (retired on 2026-08-16).
# Check https://console.groq.com/docs/deprecations before changing this value.
LLM_MODEL=openai/gpt-oss-120b
# GOOGLE_GENERATIVE_AI_API_KEY: optional Google key for the fallback provider. Enabled only together with LLM_FALLBACK_MODEL.
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# LLM_FALLBACK_MODEL: optional Google model id used for the single fallback call when the Groq call fails.
# LLM_FALLBACK_MODEL=your-fallback-model-id
# --- Live verification (SERVER ONLY) ---
# LAZARUS_SANDBOX_KILL_SWITCH: optional emergency stop for live verification of user code. A value of 1 or true engages it (POST /api/verify runs nothing for user corpses); unset, 0, or false leaves it off; any other value is treated as engaged.
# LAZARUS_SANDBOX_KILL_SWITCH=0
